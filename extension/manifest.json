{
  "manifest_version": 3,
  "name": "Tepat — Pemeriksa Bahasa Melayu",
  "version": "1.0.0",
  "description": "Sorot perkataan/struktur mencurigakan dalam Bahasa Melayu. Semakan kewujudan kata + PRPM + peraturan tatabahasa. Perlu Tepat.exe berjalan di localhost.",
  "permissions": ["storage", "activeTab", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tepat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "check-selection": {
      "suggested_key": { "default": "Ctrl+Shift+B" },
      "description": "Semak teks yang dipilih"
    }
  }
}
