 "rules": [
  {
   "id": "RB-001",
   "entry_id": "RB-001",
   "plugin": "regex_match",
   "conf": "low",
   "conf_trial": "medium",
   "status": "trial",
   "desc": "Flags the informal pattern 'adjective + sangat' (e.g., 'murah sangat') which should be 'sangat + adjective' in formal Malay.",
   "note": "Dalam bahasa formal, 'sangat' patut diletakkan sebelum kata sifat, cth: 'sangat murah', bukan 'murah sangat'.",
   "source": "LLM-translated from human description (2026-10-09)",
   "examples": {
    "trigger": [
     "Harga ini murah sangat.",
     "Makanan di situ sedap sangat.",
     "Baju itu murah sangat."
    ],
    "clear": [
     "Harga ini sangat murah.",
     "Makanan di situ sangat sedap.",
     "Baju itu sangat murah."
    ]
   },
   "params": {
    "pattern": "\\b(\\w+)\\s+sangat\\b",
    "exceptions": [
     "\\b(sangat|amat|terlalu|paling|agak|kurang|lebih|paling)\\s+sangat\\b",
     "\\bsangat\\s+sangat\\b"
    ],
    "suggestion": ""
   },
   "self_test_failures": [
    "flags clear sentence: Harga ini sangat murah.",
    "flags clear sentence: Makanan di situ sangat sedap.",
    "flags clear sentence: Baju itu sangat murah."
   ]
  }
 ],
